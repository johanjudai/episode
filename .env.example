# Database location (SQLite file path)
EPISODE_DB_URL=./data/episode.sqlite

# Optional default TMDB key. If unset, the user supplies their key in Settings.
# Get a free key at https://www.themoviedb.org/settings/api
EPISODE_TMDB_API_KEY=

# Server
EPISODE_PORT=3000
EPISODE_HOST=0.0.0.0

# Set in production behind a reverse proxy (Caddy / nginx) terminating TLS
EPISODE_ORIGIN=http://localhost:3000
