{
  "name": "episode",
  "version": "0.1.0",
  "description": "Open-source TV series tracker — self-hostable, mobile-first.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "npm run test:unit -- --run",
    "build": "vite build",
    "build:server": "cross-env EPISODE_TARGET=server vite build",
    "build:local": "cross-env EPISODE_TARGET=local vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "cap:sync": "npm run build:local && cap sync",
    "cap:open:android": "cap open android",
    "cap:run:android": "npm run cap:sync && cap run android",
    "cap:add:android": "npm run build:local && cap add android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-node": "^5.2.11",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.10.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^3.0.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.4.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.3",
    "sql.js": "^1.14.1",
    "zod": "^3.24.1"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "uuid": "^11.1.1",
    "esbuild": "^0.25.0",
    "@capacitor/cli": {
      "tar": "^7.5.15"
    },
    "@trapezedev/project": {
      "replace": {
        "minimatch": "^9.0.5"
      }
    }
  }
}
